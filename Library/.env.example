# Скопіюй цей файл у .env (в тій самій папці, що й Library.exe / поруч із
# main.cpp, якщо запускаєш через Visual Studio) і встав свої реальні дані.
# Сам файл .env НЕ комітиться в git (див. .gitignore) - у репозиторії
# лишається тільки цей приклад без реального пароля.

# Хост PostgreSQL-сервера
DB_HOST=localhost

# Порт PostgreSQL-сервера
DB_PORT=5432

# Назва бази даних
DB_NAME=library

# Логін користувача PostgreSQL
DB_USER=postgres

# Пароль користувача PostgreSQL
DB_PASSWORD=admin1
